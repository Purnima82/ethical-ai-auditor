# ─────────────────────────────────────────────────────────────
#  Ethical AI Auditor — Environment Configuration
#  Copy to .env and fill in ONE provider section
# ─────────────────────────────────────────────────────────────

# CHOOSE YOUR FREE PROVIDER: groq | gemini | openrouter | ollama | anthropic
LLM_PROVIDER=groq

# ── OPTION 1: GROQ (Recommended — fastest, truly free) ───────
# Sign up free at: console.groq.com → API Keys (no credit card)
LLM_API_KEY=your-groq-key-here
LLM_MODEL=llama-3.3-70b-versatile

# ── OPTION 2: GOOGLE GEMINI (1M tokens/day free) ─────────────
# LLM_PROVIDER=gemini
# LLM_API_KEY=AIzaSyArXY98Tc3RivwsArRgJoY0tJi8BeddR3M
# LLM_MODEL=gemini-1.5-flash

# ── OPTION 3: OPENROUTER (many free models) ──────────────────
# LLM_PROVIDER=openrouter
# LLM_API_KEY=AIzaSyArXY98Tc3RivwsArRgJoY0tJi8BeddR3M
# LLM_MODEL=meta-llama/llama-3.1-8b-instruct:free

# ── OPTION 4: OLLAMA (100% local, zero cost, no key) ─────────
# Install ollama.ai, run: ollama pull llama3.2
# LLM_PROVIDER=ollama
# LLM_API_KEY=AIzaSyArXY98Tc3RivwsArRgJoY0tJi8BeddR3M
# LLM_MODEL=llama3.2

# ── APP SETTINGS ─────────────────────────────────────────────
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173
